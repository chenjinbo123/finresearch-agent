# Copy this file to .env when you have created a DeepSeek API key.
# Never commit the real .env file or paste its key into source code.
DEEPSEEK_API_KEY=

# These defaults are appropriate for the DeepSeek OpenAI-compatible API.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30

# "none" keeps keyword retrieval only. "local_hash" is an offline learning
# provider. "dashscope" calls Alibaba Cloud Model Studio / DashScope.
EMBEDDING_PROVIDER=none
EMBEDDING_DIMENSION=128

# DashScope is only used when EMBEDDING_PROVIDER=dashscope.
# Create this key in the same Model Studio business space that has the
# Qwen Text Embedding trial quota. Never commit the real .env file.
DASHSCOPE_API_KEY=
# `text-embedding-v3` is the API model identifier used by default. If your
# Model Studio model details page gives a different API model name, replace it here.
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_EMBEDDING_DIMENSION=1024
DASHSCOPE_EMBEDDING_TIMEOUT_SECONDS=30
